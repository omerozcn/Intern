# docker-compose.yml bu degerleri okur. Kopyalayin: cp .env.example .env
# .env dosyasi .gitignore tarafindan yok sayilir, gercek degerler depoya girmez.

# SQL Server SA parolasi. En az 8 karakter; buyuk/kucuk harf, rakam ve sembol icermeli.
MSSQL_SA_PASSWORD=degistir-Guclu-Parola-1

# JWT imzalama anahtari. En az 32 byte. Uretmek icin (PowerShell):
#   $b = New-Object byte[] 64
#   [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b)
#   [Convert]::ToBase64String($b)
JWT_SIGNING_KEY=

# Gelistirme hesaplarinin tohumlanmasi. Acikken migration'lar uygulanir ve
# README'deki iki hesap olusturulur. Erisilebilir bir ortamda false yapin
# (ve migration'lari ayrica uygulayin) ya da asagidaki parolalari degistirin.
# SEED_DEVELOPMENT_ACCOUNTS=true
# SEED_ADMIN_PASSWORD=
# SEED_USER_PASSWORD=

# Opsiyonel - varsayilanlari degistirmek icin
# API_PORT=5005
# DB_PORT=1433
# JWT_ISSUER=http://localhost:5005
# JWT_AUDIENCE=http://localhost:5005
# FRONTEND_BASE_URL=http://localhost:5173
